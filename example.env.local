# LinkYoSelf backend (link-yo-self-be).
# FE yollari /v1/... seklinde ekledigi icin URL /api ile bitmeli.
# Backend'i calistirmak icin: uvicorn main:app --reload
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Kayit olma acik: backend'de POST /v1/auth/register mevcut.
NEXT_PUBLIC_IS_SIGN_UP_ENABLED=true

# Playwright e2e: backend'in stdout'unu yazdigi dosya.
# SMTP yapilandirilmadiginda EmailSender postayi log'a yaziyor; dogrulama ve
# sifre sifirlama testleri token'i buradan okuyor (playwright-tests/helpers/mail.ts).
E2E_BACKEND_LOG=/tmp/linkyoself-backend.log

# Sitenin herkese acik adresi. canonical, og:url ve uretilen paylasim
# kartinin adresi bundan kuruluyor; kaziyicilar goreli yol cozemez.
# Yayinda gercek alan adi yazilmali -- deger derleme aninda gomuluyor.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sitemap parca boyutu. Standart tek dosya icin 50.000 URL'de kesiyor;
# varsayilan 10.000 bunun epey altinda. Testler gercek bir parca
# sinirini on binlerce profil yaratmadan sinayabilmek icin kucultuyor.
# SITEMAP_SHARD_SIZE=10000

# Herkese acik profil sayfasinin tazelik penceresi (saniye, varsayilan 60).
# Normalde sayfa kaydetme aninda temizleniyor; bu sure yalnizca temizlik
# ETKI ETMEDIGINDE devreye giriyor. revalidateTag yalnizca cagrinin dustugu
# Next ornegini temizledigi icin, birden fazla ornekle kosuluyorsa staleligin
# tavani bu deger oluyor (bkz. docs/architecture.md).
# PROFILE_CACHE_SECONDS=60
