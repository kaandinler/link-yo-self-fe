# LinkYoSelf backend (link-yo-self-be).
# FE yollari /v1/... seklinde ekledigi icin URL /api ile bitmeli.
# Backend'i calistirmak icin: uvicorn main:app --reload
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Kayit olma acik: backend'de POST /v1/auth/register mevcut.
NEXT_PUBLIC_IS_SIGN_UP_ENABLED=true

# Playwright e2e: backend'in stdout'unu yazdigi dosya.
# SMTP yapilandirilmadiginda EmailSender postayi log'a yaziyor; dogrulama ve
# sifre sifirlama testleri token'i buradan okuyor (playwright-tests/helpers/mail.ts).
E2E_BACKEND_LOG=/tmp/linkyoself-backend.log
