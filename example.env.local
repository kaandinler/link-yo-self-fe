# LinkYoSelf backend (link-yo-self-be).
# FE yollari /v1/... seklinde ekledigi icin URL /api ile bitmeli.
# Backend'i calistirmak icin: uvicorn main:app --reload
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Kayit olma acik: backend'de POST /v1/auth/register mevcut.
NEXT_PUBLIC_IS_SIGN_UP_ENABLED=true

# Sosyal giris KAPALI. Backend'de /v1/auth/google/login ve
# /v1/auth/facebook/login uclari yok; acilirsa butonlar 404 alir.
# Backend'e sosyal giris eklenirse true yapip ID'leri doldurun.
NEXT_PUBLIC_IS_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_IS_FACEBOOK_AUTH_ENABLED=false
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Dosya yukleme surucusu: "local", "s3" veya "s3-presigned".
# NOT: Backend'de henuz /v1/files/upload ucu yok, yukleme calismaz.
NEXT_PUBLIC_FILE_DRIVER=local

# Playwright e2e testlerinin dogrulama e-postalarini okumasi icin.
# Bunlar boilerplate'in e-posta akisina ait; LinkYoSelf backend'inde
# e-posta dogrulama ucu bulunmuyor. Kendi test hesabinizi girin.
TEST_IMAP_USER=
TEST_IMAP_PASSWORD=
TEST_IMAP_HOST=
TEST_IMAP_PORT=993
TEST_IMAP_TLS=true
